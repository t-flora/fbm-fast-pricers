## Data flow for the Rough Volatility Asian Option Pricer
## Render with: d2 dataflow.d2 dataflow.svg
## Install: brew install d2

direction: right

# ── Layer 1: Market data ─────────────────────────────────────────────────────

oxford: |md
## Oxford-Man Realized Library
high-freq RV data
| {shape: cylinder}

yfinance: |md
## yfinance
free proxy via 5-day squared returns
| {shape: cylinder}

# ── Layer 2: Calibration ──────────────────────────────────────────────────────

calibrate: |md
## `calibrate.py`
Variogram fit of log-vol
slope → H, intercept → ν (time in years)
| {shape: rectangle}

params: |md
## `params.hpp` + `params.py`
H = 0.10, ν = 0.52, σ₀ = 0.2, S₀, K, T, r
(kept in sync by a test)
| {shape: document}

oxford   -> calibrate
yfinance -> calibrate: "alt."
calibrate -> params: "compare with\nliterature values"

# ── Layer 3a: C++ engine ──────────────────────────────────────────────────────

cpp: C++ Engine {
  cov: |md
## `covariance.hpp`
Build N×N matrix C
from fBM kernel (analytic)
| {shape: rectangle}

  alg1: |md
## Algorithm 1 — Dense Cholesky
`src/cholesky/cholesky.hpp`
setup : C = LLᵀ — O(N³)
per path: Lz — O(N²)
| {shape: rectangle}

  alg2: |md
## Algorithm 2 — Circulant + FFTW
`src/fft/fft.hpp`
setup : FFT(γ) → λ — O(N log N)
per path: IFFT(√λ·w) — O(N log N)
| {shape: rectangle}

  alg3: |md
## Algorithm 3 — Global low-rank rSVD
`src/rsvd/lowrank.hpp`
setup : rSVD → Lₖ — O(N²k)
per path: Lₖz — O(Nk)
| {shape: rectangle}

  cov -> alg1
  cov -> alg2: "fGn γ(k) only\n(not C itself)"
  cov -> alg3
}

params -> cpp.cov

# ── Layer 3b: Python engine ───────────────────────────────────────────────────

py: |md
## `rfsv_model.py`
NumPy circulant-FFT engine
(matches C++ FFTW convention)
+ control-variate pricer
| {shape: rectangle}

params -> py: "H, ν, σ₀ (imported)"

# ── Layer 4: Benchmark runner ─────────────────────────────────────────────────

bench: |md
## `benchmark.cpp`
Runs all three `price_timed()`
N from 64 to 4000, M = 10 000 paths,
median of 3 timings
| {shape: rectangle}

cpp.alg1 -> bench
cpp.alg2 -> bench
cpp.alg3 -> bench

# ── Layer 5: CSV outputs ──────────────────────────────────────────────────────

csvs: benchmarks/results/ {
  shape: cylinder

  t: |md
## `time_vs_N.csv`
wall time, construction + MC split
measured peak memory, streaming rate
|

  e: |md
## `error_vs_rank.csv`
Frobenius ‖C−Cₖ‖_F/‖C‖_F
price error vs p_ref (100k paths/rank)
|

  r: |md
## `reference_price.txt`
p_ref = 5.314
avg of 500k-path Chol + 500k-path FFT
|
}

bench -> csvs.t
bench -> csvs.e
bench -> csvs.r

# ── Extensions: variance correction + control variate ────────────────────────

ext: |md
## `extensions.cpp`
variance-corrected low-rank vs rank;
control variate per sampler
(variance reduction, time to 0.1% SE)
| {shape: rectangle}

cpp.alg1 -> ext
cpp.alg2 -> ext
cpp.alg3 -> ext
csvs.r -> ext: "reference"

extcsv: |md
## `variance_corrected_rank.csv`
## `control_variate.csv`
| {shape: cylinder}

ext -> extcsv

plotext: |md
## `plot_extensions.py`
→ variance_corrected_rank.png
→ control_variate.png
| {shape: rectangle}

extcsv -> plotext

# ── Performance: batched sampling, fast generator, threads ───────────────────

perf: |md
## `performance.cpp`
batched (B = 64) vs per-path, mt19937 vs ziggurat,
thread scaling; via `batched_mc.hpp`, `fast_rng.hpp`
| {shape: rectangle}

cpp.alg1 -> perf
cpp.alg2 -> perf
cpp.alg3 -> perf

perfcsv: |md
## `perf_{breakdown,batched,`
## `batch_size,threads}.csv`
| {shape: cylinder}

perf -> perfcsv

plotperf: |md
## `plot_performance.py`
→ perf_breakdown.png, perf_batched.png
→ perf_batch_size.png, perf_threads.png
| {shape: rectangle}

perfcsv -> plotperf

# ── Tests & CI ────────────────────────────────────────────────────────────────

tests: |md
## `tests/` + CI
test_samplers.cpp (ctest), test_python.py (pytest)
on pushes to main and PRs (Ubuntu gating, macOS informational);
Ubuntu also runs `run_pipeline.sh --fast` and checks every figure
| {shape: rectangle}

cpp -> tests
py -> tests

# ── Layer 6: Analysis & plots ─────────────────────────────────────────────────

scaling: |md
## `plot_scaling.py`
→ time_vs_N.png
→ construction_breakdown.png
→ memory_vs_N.png, error_vs_rank.png
| {shape: rectangle}

structure: |md
## `plot_structure.py`
→ structure_analysis.png
Toeplitz heatmaps + off-diagonal SVD decay
| {shape: rectangle}

sensitivity: |md
## `plot_sensitivity.py`
→ sensitivity_surface.png
→ sensitivity_strike.png
| {shape: rectangle}

iv: |md
## `validate_iv.py`
→ validate_iv.png
RFSV IV smile vs live SPY chains
| {shape: rectangle}

asian: |md
## `validate_asian.py`
→ validate_asian.png, roughness_share.csv
Lévy benchmark + roughness premium (3 normalizations)
| {shape: rectangle}

conv: |md
## `validate_convergence.py`
→ convergence.png
price ±1σ vs M paths, plain and CV; σ ∝ 1/√M
| {shape: rectangle}

stab: |md
## `validate_stability.py`
→ stability_report.png
FFT eigenvalue positivity, rSVD κ(Lₖ), Cholesky κ(C)
| {shape: rectangle}

greeks: |md
## `greeks.py`
→ greeks.png
pathwise vs FD vega, dV/dH (control variate)
| {shape: rectangle}

mem: |md
## `profile_memory.py`
→ memory_profile.png
tracemalloc peak vs N and M
| {shape: rectangle}

csvs.t -> scaling
csvs.e -> scaling

py -> structure
py -> sensitivity
py -> iv
py -> asian
py -> conv
py -> stab
py -> mem
py -> greeks
